# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Future Supabase Configuration (do not fill with real keys yet)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AI Doubt Solver Configuration (OpenAI API or compatible server-side provider)
# Replace with your actual OpenAI API key (e.g. sk-proj-...)
OPENAI_API_KEY=
# Optional: Model name (defaults to gpt-4o-mini if not provided)
OPENAI_MODEL=gpt-4o-mini
# Optional: Custom base URL (e.g. https://api.openai.com/v1 or custom proxy/provider)
OPENAI_BASE_URL=https://api.openai.com/v1
